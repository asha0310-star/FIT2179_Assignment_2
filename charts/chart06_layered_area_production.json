{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Production rose almost in lockstep with planted area",
    "subtitle": "Malaysia: CPO production (bars) and planted area (line), 2000–2024",
    "anchor": "start"
  },
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "bottom": 40
  },
  "data": {
    "url": "data/malaysia_yearly.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.cpo_production_Mt)",
      "as": "cpo_production_Mt_num"
    },
    {
      "calculate": "toNumber(datum.planted_area_Mha)",
      "as": "planted_area_Mha_num"
    },
    {
      "filter": "isFinite(datum.cpo_production_Mt_num) && isFinite(datum.planted_area_Mha_num)"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelOverlap": "greedy",
        "labelFont": "Inter",
        "labelFontSize": 12,
        "labelColor": "#333333"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#c25e1e",
        "opacity": 0.85
      },
      "encoding": {
        "y": {
          "field": "cpo_production_Mt_num",
          "type": "quantitative",
          "title": "CPO production (million tonnes)",
          "axis": {
            "titleColor": "#c25e1e",
            "grid": true,
            "gridColor": "#eeece4"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "cpo_production_Mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Production (Mt)"
          },
          {
            "field": "planted_area_Mha",
            "type": "quantitative",
            "format": ".2f",
            "title": "Area (Mha)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#2d5a3d",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 40
        }
      },
      "encoding": {
        "y": {
          "field": "planted_area_Mha_num",
          "type": "quantitative",
          "title": "Planted area (million hectares)",
          "axis": {
            "titleColor": "#2d5a3d"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "planted_area_Mha",
            "type": "quantitative",
            "format": ".2f",
            "title": "Area (Mha)"
          },
          {
            "field": "cpo_production_Mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Production (Mt)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "toNumber(datum.year) == 2018"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 0,
        "dy": -90,
        "fontSize": 12,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#1f2421",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "planted_area_Mha_num",
          "type": "quantitative"
        },
        "text": {
          "value": "Production tracks area almost 1:1"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  }
}