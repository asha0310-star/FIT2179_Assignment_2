{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Palm expansion and forest loss overlap, but later years drift down",
    "subtitle": "Each dot = one year, 2001–2024. Colour shows time; points are not connected because both axes are quantitative.",
    "anchor": "start"
  },
  "width": "container",
  "height": 460,
  "data": {
    "url": "data/area_vs_loss_yearly.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.planted_area_Mha) && isValid(datum.forest_loss_kha)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "title": "Malaysia's oil palm planted area (million hectares)",
          "axis": {
            "grid": true,
            "gridColor": "#eeece4"
          }
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative",
          "title": "Tree cover loss that year (thousand hectares)",
          "axis": {
            "grid": true,
            "gridColor": "#eeece4"
          }
        },
        "color": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges"
          },
          "title": "Year",
          "legend": {
            "orient": "right",
            "gradientLength": 200,
            "format": "d"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "planted_area_Mha",
            "type": "quantitative",
            "title": "Planted area (Mha)",
            "format": ".2f"
          },
          {
            "field": "forest_loss_kha",
            "type": "quantitative",
            "title": "Forest loss (000 ha)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2001 || datum.year == 2009 || datum.year == 2012 || datum.year == 2014 || datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1f2421",
        "font": "Inter"
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2020"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 18,
        "dy": 4,
        "align": "left",
        "fontSize": 11,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "value": "Late years drift down and right"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 12
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
