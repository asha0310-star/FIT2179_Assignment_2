{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Palm expansion and forest loss overlap, but later years drift down",
    "subtitle": "Connected annual path, 2001–2024: planted area on x-axis and tree-cover loss on y-axis.",
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "data": {
    "url": "data/area_vs_loss_yearly.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.planted_area_Mha) && isValid(datum.forest_loss_kha)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#6b7570",
        "opacity": 0.45,
        "strokeWidth": 2,
        "interpolate": "linear"
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "title": "Malaysia's oil palm planted area (million hectares)",
          "axis": {
            "grid": true,
            "gridColor": "#eeece4"
          }
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative",
          "title": "Tree cover loss that year (thousand hectares)",
          "axis": {
            "grid": true,
            "gridColor": "#eeece4"
          }
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "size": {
          "value": 150
        },
        "opacity": {
          "value": 0.88
        },
        "color": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "scheme": "viridis"
          },
          "title": "Year",
          "legend": {
            "orient": "right",
            "gradientLength": 200,
            "format": "d"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "planted_area_Mha",
            "type": "quantitative",
            "title": "Planted area (Mha)",
            "format": ".2f"
          },
          {
            "field": "forest_loss_kha",
            "type": "quantitative",
            "title": "Forest loss (000 ha)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2001 || datum.year == 2009 || datum.year == 2012 || datum.year == 2014 || datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1f2421",
        "font": "Inter"
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "planted_area_Mha": 5.42,
            "forest_loss_kha": 245,
            "label": "Late years drift down\nfrom the 2014 peak"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "fontStyle": "italic",
        "lineBreak": "\n",
        "color": "#1f2421",
        "dx": 8,
        "dy": -10,
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "planted_area_Mha": 5.61,
            "forest_loss_kha": 282.53,
            "label": "2024: lower loss\nthan the peak"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "lineBreak": "\n",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "planted_area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
