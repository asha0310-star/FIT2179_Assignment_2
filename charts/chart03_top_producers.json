{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Two producers dominate the world market",
    "subtitle": "Ranked crude palm oil production by country (million tonnes); move the slider to change year."
  },
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/cpo_by_country_long.csv"
  },
  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2014,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "toNumber(datum.Production_kt)",
      "as": "Production_kt_num"
    },
    {
      "calculate": "datum.Country == 'World' ? datum.Production_kt_num : null",
      "as": "World_candidate"
    },
    {
      "aggregate": [
        {
          "op": "max",
          "field": "World_candidate",
          "as": "World_kt"
        }
      ],
      "groupby": [
        "Period"
      ]
    },
    {
      "filter": "datum.Country !== 'World' && datum.Period == year_select"
    },
    {
      "calculate": "datum.Production_kt_num / 1000",
      "as": "Production_Mt"
    },
    {
      "calculate": "datum.Production_kt_num / datum.World_kt * 100",
      "as": "share_pct"
    },
    {
      "calculate": "datum.Country === 'Malaysia' || datum.Country === 'Indonesia' ? datum.Country : 'Other'",
      "as": "Group"
    },
    {
      "calculate": "format(datum.Production_Mt, '.1f') + ' Mt \u00b7 ' + format(datum.share_pct, '.1f') + '%'",
      "as": "value_label"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "Production_Mt",
          "order": "descending"
        }
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "opacity": 0.55
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelLimit": 120
          }
        },
        "x": {
          "datum": 0,
          "type": "quantitative",
          "title": "Crude palm oil production (Mt)",
          "scale": {
            "domain": [
              0,
              48
            ]
          },
          "axis": {
            "grid": true,
            "tickCount": 6
          }
        },
        "x2": {
          "field": "Production_Mt"
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indonesia",
              "Malaysia",
              "Other"
            ],
            "range": [
              "#2d5a3d",
              "#c25e1e",
              "#b9c0bc"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Country"
          },
          {
            "field": "Production_Mt",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "World share (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "stroke": "white",
        "strokeWidth": 1.8
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Production_Mt",
          "type": "quantitative"
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indonesia",
              "Malaysia",
              "Other"
            ],
            "range": [
              "#2d5a3d",
              "#c25e1e",
              "#b9c0bc"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1f2421"
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Production_Mt",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Country": "Thailand",
            "Production_Mt": 28,
            "note": "Indonesia + Malaysia account for about 80\u201385%\nof the world total in recent years."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "font": "Inter",
        "fontSize": 12,
        "fontStyle": "italic",
        "lineBreak": "\n",
        "color": "#3a4540"
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Production_Mt",
          "type": "quantitative"
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  }
}