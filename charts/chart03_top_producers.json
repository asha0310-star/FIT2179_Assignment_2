{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Two producers dominate the world market",
    "subtitle": [
      "Crude palm oil production by country (Mt).",
      "Use the slider below to change year."
    ]
  },
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/cpo_by_country_long.csv"
  },
  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2014,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "toNumber(datum.Production_kt)",
      "as": "Production_kt_num"
    },
    {
      "calculate": "datum.Country == 'World' ? datum.Production_kt_num : null",
      "as": "World_candidate"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "World_candidate",
          "as": "World_kt"
        }
      ],
      "groupby": [
        "Period"
      ]
    },
    {
      "filter": "datum.Country !== 'World' && datum.Period == year_select"
    },
    {
      "calculate": "datum.Production_kt_num / 1000",
      "as": "Production_Mt"
    },
    {
      "calculate": "datum.Production_kt_num / datum.World_kt * 100",
      "as": "share_pct"
    },
    {
      "calculate": "datum.Country === 'Malaysia' || datum.Country === 'Indonesia' ? datum.Country : 'Other'",
      "as": "Group"
    },
    {
      "calculate": "format(datum.Production_Mt, '.1f') + ' (' + format(datum.share_pct, '.1f') + '%)'",
      "as": "value_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "opacity": 0.55
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "title": null,
          "axis": {
            "labelLimit": 120
          }
        },
        "x": {
          "field": "Production_Mt",
          "type": "quantitative",
          "title": "Crude palm oil production (Mt)",
          "scale": {
            "domain": [
              0,
              46
            ]
          },
          "axis": {
            "grid": true,
            "tickCount": 6,
            "gridColor": "#eeeeee",
            "labelColor": "#3a4540"
          }
        },
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indonesia",
              "Malaysia",
              "Other"
            ],
            "range": [
              "#2d5a3d",
              "#c25e1e",
              "#8f9792"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal"
          },
          {
            "field": "Period",
            "type": "quantitative",
            "format": "d",
            "title": "Selected year"
          },
          {
            "field": "Production_Mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Production (Mt)"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "World share (%)"
          }
        ],
        "opacity": {
          "value": 0.72
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "stroke": "white",
        "strokeWidth": 1.8
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal"
        },
        "x": {
          "field": "Production_Mt",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              46
            ]
          },
          "axis": {
            "gridColor": "#eeeeee",
            "tickCount": 6,
            "labelColor": "#3a4540"
          }
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indonesia",
              "Malaysia",
              "Other"
            ],
            "range": [
              "#2d5a3d",
              "#c25e1e",
              "#8f9792"
            ]
          },
          "legend": null
        },
        "opacity": {
          "value": 0.95
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal"
        },
        "x": {
          "field": "Production_Mt",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              46
            ]
          },
          "axis": {
            "gridColor": "#eeeeee",
            "tickCount": 6,
            "labelColor": "#3a4540"
          }
        },
        "text": {
          "field": "value_label"
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indonesia",
              "Malaysia",
              "Other"
            ],
            "range": [
              "#2d5a3d",
              "#c25e1e",
              "#8f9792"
            ]
          },
          "legend": null
        },
        "opacity": {
          "value": 0.9
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal"
        },
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "Country"
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indonesia",
              "Malaysia",
              "Other"
            ],
            "range": [
              "#2d5a3d",
              "#c25e1e",
              "#8f9792"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#3a4540",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeeeee",
      "gridOpacity": 0.75
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#3a4540",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#4b5563",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  },
  "padding": {
    "top": 18,
    "right": 42,
    "bottom": 72,
    "left": 8
  }
}