{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Two countries make 85% of the world's palm oil",
    "subtitle": "CPO production, 2024 (thousand tonnes)",
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 16,
    "subtitleFont": "Inter",
    "subtitleColor": "#6b7570"
  },
  "width": 460,
  "height": 320,
  "data": {"url": "data/cpo_by_country_long.csv"},
  "transform": [
    {"filter": "datum.Country !== 'World'"},
    {"filter": "datum.Period == 2024"}
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 2},
  "encoding": {
    "y": {
      "field": "Country",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {"labelFont": "Inter", "labelFontSize": 12}
    },
    "x": {
      "field": "Production_kt",
      "type": "quantitative",
      "title": "Thousand tonnes",
      "axis": {"grid": true, "gridColor": "#eeece4"}
    },
    "color": {
      "condition": {"test": "datum.Country === 'Malaysia'", "value": "#c25e1e"},
      "value": "#d6dad7"
    },
    "tooltip": [
      {"field": "Country", "type": "nominal"},
      {"field": "Production_kt", "type": "quantitative", "format": ",", "title": "Production (000 t)"}
    ]
  },
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "domain": false, "ticks": false,
      "labelFont": "Inter", "titleFont": "Inter",
      "labelColor": "#6b7570", "titleColor": "#1f2421"
    }
  }
}
