{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Is each tonne of palm oil costing less forest?",
    "subtitle": [
      "Derived metric: thousand hectares of tree cover lost per million tonnes of crude palm oil produced (kha / Mt).",
      "Lower is better. Colour bands: red = >30, orange = 20–30, green = <20."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 320,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"top": 10, "bottom": 30, "left": 10, "right": 10},
  "data": {"url": "data/malaysia_economy_yearly.csv"},

  "transform": [
    {"calculate": "toNumber(datum.forest_loss_kha)",    "as": "loss_num"},
    {"calculate": "toNumber(datum.cpo_production_Mt)",  "as": "prod_num"},
    {"calculate": "datum.loss_num / datum.prod_num",    "as": "efficiency"},
    {"calculate": "datum.efficiency > 30 ? 'High cost (>30)' : (datum.efficiency >= 20 ? 'Moderate (20–30)' : 'Improving (<20)')", "as": "band"},
    {"calculate": "toNumber(datum.year) == 2014 ? 'Worst year: 33' : (toNumber(datum.year) == 2022 ? 'Best recent: 13' : null)", "as": "annotation"}
  ],

  "layer": [
    {
      "data": {"values": [
        {"y0": 0, "y1": 20, "band": "Improving (<20)"},
        {"y0": 20, "y1": 30, "band": "Moderate (20–30)"},
        {"y0": 30, "y1": 60, "band": "High cost (>30)"}
      ]},
      "mark": {"type": "rect", "opacity": 0.07},
      "encoding": {
        "y": {"field": "y0", "type": "quantitative"},
        "y2": {"field": "y1"},
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": ["High cost (>30)", "Moderate (20–30)", "Improving (<20)"],
            "range":  ["#b22222", "#c25e1e", "#2d5a3d"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 1.5, "color": "#6b7570", "opacity": 0.5},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": null,
              "axis": {"labelAngle": 0, "labelOverlap": "greedy"}},
        "y": {"field": "efficiency", "type": "quantitative",
              "title": "Forest loss per tonne of CPO (kha / Mt)",
              "scale": {"domain": [0, 50]}}
      }
    },
    {
      "mark": {"type": "circle", "size": 110, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "efficiency", "type": "quantitative"},
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": ["High cost (>30)", "Moderate (20–30)", "Improving (<20)"],
            "range":  ["#b22222", "#c25e1e", "#2d5a3d"]
          },
          "legend": {"orient": "bottom", "title": "Efficiency band"}
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "efficiency", "type": "quantitative", "format": ".1f", "title": "kha / Mt"},
          {"field": "forest_loss_kha", "type": "quantitative", "format": ".1f", "title": "Forest loss (kha)"},
          {"field": "cpo_production_Mt", "type": "quantitative", "format": ".2f", "title": "CPO (Mt)"},
          {"field": "band", "type": "nominal", "title": "Band"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.annotation != null"}],
      "mark": {"type": "text", "dy": -14, "fontSize": 11, "fontWeight": 600, "font": "Inter", "color": "#1f2421"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "efficiency", "type": "quantitative"},
        "text": {"field": "annotation"}
      }
    }
  ],

  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 11,
      "titleColor": "#6b7570",
      "labelColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  }
}
