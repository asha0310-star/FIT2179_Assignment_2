{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "East Malaysia overtook the Peninsula",
    "subtitle": "CPO production by region (million tonnes), 2000–2024"
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/region_production_yearly.csv"
  },
  "transform": [
    {
      "calculate": "datum.cpo_production_t / 1000000",
      "as": "cpo_production_Mt"
    }
  ],
  "layer": [
    {
      "mark": "area",
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelOverlap": "greedy"
          }
        },
        "y": {
          "field": "cpo_production_Mt",
          "type": "quantitative",
          "title": "CPO production (Mt)",
          "stack": "zero"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "scale": {
            "domain": [
              "Peninsular Malaysia",
              "Sabah",
              "Sarawak"
            ],
            "range": [
              "#8a5a2b",
              "#5c8a6e",
              "#1f3d2f"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "region",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "cpo_production_Mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Production (Mt)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#1f2421",
        "strokeDash": [
          4,
          4
        ],
        "opacity": 0.6
      },
      "encoding": {
        "x": {
          "datum": 2007,
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -10,
        "fontSize": 11,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "datum": 2007,
          "type": "ordinal"
        },
        "y": {
          "datum": 17,
          "type": "quantitative"
        },
        "text": {
          "value": "2007: East Malaysia overtakes Peninsula"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
