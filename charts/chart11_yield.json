{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "More land, but not more oil per hectare",
    "subtitle": "Malaysia CPO yield (tonnes per hectare), 2000–2024",
    "anchor": "start"
  },
  "width": 460,
  "height": 320,
  "data": {
    "url": "data/malaysia_yearly.csv"
  },
  "transform": [
    {
      "calculate": "datum.cpo_production_Mt / datum.planted_area_Mha",
      "as": "yield_t_per_ha"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#2d5a3d",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelOverlap": "greedy"
          }
        },
        "y": {
          "field": "yield_t_per_ha",
          "type": "quantitative",
          "title": "Tonnes per hectare"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "yield_t_per_ha",
            "type": "quantitative",
            "format": ".2f",
            "title": "Yield (t/ha)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "color": "#2d5a3d",
        "filled": true,
        "size": 60
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "yield_t_per_ha",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "yield_t_per_ha",
              "as": "mean_yield"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#6b7570",
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "y": {
          "field": "mean_yield",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "yield_t_per_ha",
              "as": "mean_yield"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -6,
        "fontSize": 11,
        "font": "Inter",
        "color": "#6b7570"
      },
      "encoding": {
        "x": {
          "value": 5
        },
        "y": {
          "field": "mean_yield",
          "type": "quantitative"
        },
        "text": {
          "value": "Long-run mean"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2005"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 10,
        "dy": -12,
        "align": "left",
        "fontSize": 11,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "yield_t_per_ha",
          "type": "quantitative"
        },
        "text": {
          "value": "Peak yield: 2005"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 12
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  }
}