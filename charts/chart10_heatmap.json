{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tree cover loss by state and year",
    "subtitle": "Annual tree-cover loss by state, 2001–2024 (thousand hectares). States sorted by total loss.",
    "anchor": "start"
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/forest_loss_by_state_long.csv"
  },
  "transform": [
    {
      "calculate": "datum.tc_loss_ha / 1000",
      "as": "loss_kha"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "state_hover",
          "select": {
            "type": "point",
            "fields": ["state"],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelOverlap": "greedy"
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {
            "op": "max",
            "field": "loss_kha",
            "order": "descending"
          }
        },
        "color": {
          "field": "loss_kha",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges"
          },
          "title": "Loss (000 ha)",
          "legend": {
            "orient": "bottom"
          }
        },
        "opacity": {
          "condition": {
            "param": "state_hover",
            "value": 0.9,
            "empty": false
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "loss_kha",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Loss (000 ha)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2012
          },
          {
            "year": 2014
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [3, 3],
        "strokeWidth": 1.2,
        "color": "#1f2421",
        "opacity": 0.45
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2012,
            "state": "Sarawak",
            "label": "2012 peak"
          },
          {
            "year": 2014,
            "state": "Sarawak",
            "label": "2014 peak"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontStyle": "italic",
        "align": "left",
        "dx": 4,
        "dy": -10,
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "state",
          "type": "nominal"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 12
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
