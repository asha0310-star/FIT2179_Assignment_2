{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tree cover loss by state and year",
    "subtitle": "Full overview of annual tree cover loss, 2001–2024 (thousand hectares). Darker cells show higher loss.",
    "anchor": "start"
  },
  "width": 420,
  "height": 360,
  "data": {
    "url": "data/forest_loss_by_state_long.csv"
  },
  "transform": [
    {
      "calculate": "datum.tc_loss_ha / 1000",
      "as": "loss_kha"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "state_hover",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelOverlap": "greedy"
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {
            "op": "max",
            "field": "loss_kha",
            "order": "descending"
          }
        },
        "color": {
          "field": "loss_kha",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges"
          },
          "title": "Loss (000 ha)",
          "legend": {
            "orient": "bottom"
          }
        },
        "opacity": {
          "condition": {
            "param": "state_hover",
            "value": 0.9,
            "empty": false
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "loss_kha",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Loss (000 ha)"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 12
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  }
}