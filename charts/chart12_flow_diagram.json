{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Malaysia's palm oil flows — and how little is certified",
    "subtitle": [
      "Trade flow from Malaysia to its top seven importers, 2024.",
      "Ribbon thickness = export volume (Mt). Green = RSPO-certified market; grey = mostly conventional."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "top": 10,
    "bottom": 20,
    "left": 80,
    "right": 110
  },
  "data": {
    "url": "data/imports_flows.csv"
  },
  "transform": [
    {
      "calculate": "datum.certified == 'TRUE' ? 'RSPO-certified market' : 'Conventional market'",
      "as": "Status"
    }
  ],
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -5,
          105
        ]
      }
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0.3,
          7.7
        ],
        "reverse": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "opacity": 0.75
      },
      "encoding": {
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "order": {
          "field": "order",
          "type": "ordinal"
        },
        "size": {
          "field": "volume_Mt",
          "type": "quantitative",
          "scale": {
            "range": [
              3,
              38
            ]
          },
          "legend": {
            "title": "Volume (Mt)",
            "orient": "bottom",
            "values": [
              0.5,
              1.5,
              3.0
            ]
          }
        },
        "color": {
          "field": "Status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Conventional market",
              "RSPO-certified market"
            ],
            "range": [
              "#9ca3af",
              "#2d5a3d"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "volume_Mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Volume (Mt)"
          },
          {
            "field": "Status",
            "type": "nominal",
            "title": "Status"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.point == 'source'"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "volume_Mt",
              "as": "total"
            }
          ],
          "groupby": [
            "x",
            "y"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#c25e1e",
        "size": 600,
        "opacity": 0.92,
        "stroke": "#1f2421",
        "strokeWidth": 1
      },
      "encoding": {}
    },
    {
      "data": {
        "values": [
          {
            "x": 0,
            "y": 4,
            "label": "Malaysia"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -22,
        "fontSize": 14,
        "fontWeight": 700,
        "font": "Fraunces",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0,
            "y": 4,
            "label": "16.9 Mt total exports"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": 28,
        "fontSize": 10,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#6b7570"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.point == 'dest'"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 0.95
      },
      "encoding": {
        "color": {
          "field": "Status",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.point == 'dest'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": 600,
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.point == 'dest'"
        },
        {
          "calculate": "format(datum.volume_Mt, '.2f') + ' Mt'",
          "as": "vol_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "dy": 14,
        "fontSize": 10,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#6b7570"
      },
      "encoding": {
        "text": {
          "field": "vol_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 11,
      "titleColor": "#6b7570",
      "labelColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  }
}
