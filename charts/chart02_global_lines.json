{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia and Indonesia drove global palm oil growth",
    "subtitle": "Production by group, 1961–2023 (million tonnes); ‘Other’ is aggregated across remaining producers."
  },
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/palm_production_long.csv"
  },
  "transform": [
    {
      "filter": "datum.Entity !== 'World'"
    },
    {
      "calculate": "datum['Palm oil - Production (tonnes)'] / 1e6",
      "as": "Production_Mt_raw"
    },
    {
      "calculate": "datum.Entity === 'Malaysia' || datum.Entity === 'Indonesia' ? datum.Entity : 'Other'",
      "as": "Group"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Production_Mt_raw",
          "as": "Production_Mt"
        }
      ],
      "groupby": [
        "Year",
        "Group"
      ]
    },
    {
      "calculate": "datetime(toNumber(datum.Year), 0, 1)",
      "as": "year_date"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.2,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year_date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": 9,
            "labelAngle": 0,
            "labelOverlap": "greedy"
          }
        },
        "y": {
          "field": "Production_Mt",
          "type": "quantitative",
          "title": "Million tonnes",
          "axis": {
            "grid": true,
            "gridColor": "#eeece4"
          }
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Malaysia",
              "Indonesia",
              "Other"
            ],
            "range": [
              "#c25e1e",
              "#2d5a3d",
              "#8f9792"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Group",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "format": "d"
          },
          {
            "field": "Production_Mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Production (Mt)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2023"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": 700,
        "font": "Inter"
      },
      "encoding": {
        "x": {
          "field": "year_date",
          "type": "temporal"
        },
        "y": {
          "field": "Production_Mt",
          "type": "quantitative"
        },
        "text": {
          "field": "Group"
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Malaysia",
              "Indonesia",
              "Other"
            ],
            "range": [
              "#c25e1e",
              "#2d5a3d",
              "#8f9792"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Group == 'Indonesia' && datum.Year == 2006"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 10,
        "dy": -10,
        "align": "left",
        "fontSize": 12,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "year_date",
          "type": "temporal"
        },
        "y": {
          "field": "Production_Mt",
          "type": "quantitative"
        },
        "text": {
          "value": "Indonesia overtakes Malaysia, 2006"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  }
}