{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Economic Gain, the Environmental Bill",
    "subtitle": [
      "Malaysia: palm oil export earnings (up) vs annual tree-cover loss (down), 2001–2024.",
      "Different units are rescaled to compare direction over time, not direct equivalence."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "top": 10,
    "bottom": 30,
    "left": 10,
    "right": 10
  },
  "data": {
    "url": "data/malaysia_economy_yearly.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.export_value_RMbn)",
      "as": "exports"
    },
    {
      "calculate": "toNumber(datum.forest_loss_kha)",
      "as": "loss_kha"
    },
    {
      "calculate": "-datum.loss_kha / 5",
      "as": "loss_neg"
    },
    {
      "calculate": "toNumber(datum.year) == 2008 ? '2008: GFC' : (toNumber(datum.year) == 2014 ? '2014: loss peak' : (toNumber(datum.year) == 2022 ? '2022: export record' : null))",
      "as": "annotation"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelOverlap": "greedy",
        "labelFont": "Inter",
        "labelFontSize": 11,
        "labelColor": "#333333"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#1f2421",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#c25e1e",
        "cornerRadiusEnd": 2,
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "exports",
          "type": "quantitative",
          "title": "Exports (RM bn, up) / tree-cover loss (000 ha, down; rescaled)",
          "axis": {
            "labelExpr": "datum.value >= 0 ? format(datum.value, '.0f') : format(-datum.value * 5, '.0f')",
            "titleColor": "#1f2421",
            "titleFontSize": 12,
            "grid": true,
            "gridColor": "#eeece4"
          },
          "scale": {
            "domain": [
              -150,
              150
            ]
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "exports",
            "type": "quantitative",
            "format": ".1f",
            "title": "Exports (RM bn)"
          },
          {
            "field": "loss_kha",
            "type": "quantitative",
            "format": ".1f",
            "title": "Forest loss (kha)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#2d5a3d",
        "cornerRadiusEnd": 2,
        "opacity": 0.85
      },
      "encoding": {
        "y": {
          "field": "loss_neg",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "loss_kha",
            "type": "quantitative",
            "format": ".1f",
            "title": "Forest loss (kha)"
          },
          {
            "field": "exports",
            "type": "quantitative",
            "format": ".1f",
            "title": "Exports (RM bn)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.annotation != null"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 10,
        "fontStyle": "italic",
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "exports",
          "type": "quantitative",
          "title": "Exports (RM bn, up) / tree-cover loss (000 ha, down; rescaled)"
        },
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "↑ Export earnings",
            "x": "2001",
            "y": 130
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Inter",
        "color": "#c25e1e"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "↓ Forest loss",
            "x": "2001",
            "y": -130
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": 600,
        "font": "Inter",
        "color": "#2d5a3d"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  }
}
