{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "National forest loss peaked in 2014",
    "subtitle": "Annual tree-cover loss, 2001–2024. Includes harvest and plantation rotation, not only primary forest clearing.",
    "anchor": "start"
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/area_vs_loss_yearly.csv"
  },
  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "forest_loss_kha",
              "as": "mean_loss"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#6b7570",
        "strokeDash": [
          4,
          4
        ],
        "opacity": 0.55
      },
      "encoding": {
        "y": {
          "field": "mean_loss",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#c25e1e",
        "strokeWidth": 2.8,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "values": [
              2001,
              2005,
              2010,
              2015,
              2020,
              2024
            ],
            "labelOverlap": "greedy"
          }
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative",
          "title": "Tree cover loss (000 ha)"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "forest_loss_kha",
            "type": "quantitative",
            "format": ".1f",
            "title": "Loss (000 ha)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2014 || datum.year == 2024"
        }
      ],
      "mark": {
        "type": "point",
        "color": "#c25e1e",
        "filled": true,
        "size": 85,
        "stroke": "#fff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2014,
            "y": 646.03,
            "y2": 710
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1f2421",
        "strokeWidth": 1,
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2014,
            "y": 710,
            "label": "Peak loss year\n2014: 646 kha"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -4,
        "fontSize": 11,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "color": "#1f2421",
        "font": "Inter"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        },
        {
          "calculate": "'2024: ' + format(datum.forest_loss_kha, '.0f') + ' kha'",
          "as": "final_label"
        }
      ],
      "mark": {
        "type": "text",
        "dx": -6,
        "dy": -12,
        "align": "right",
        "fontSize": 11,
        "font": "Inter",
        "color": "#1f2421"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "field": "final_label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#1f2421",
      "grid": true,
      "gridColor": "#eeece4"
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#1f2421"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "subtitleLineHeight": 18,
      "anchor": "start"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
