{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The peak years: 2012 and 2014",
    "subtitle": "Annual tree cover loss, Malaysia, 2001–2024",
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 16,
    "subtitleFont": "Inter",
    "subtitleColor": "#6b7570"
  },
  "width": 460,
  "height": 320,
  "data": {"url": "data/forest_loss_by_state_long.csv"},
  "transform": [
    {
      "aggregate": [{"op": "sum", "field": "tc_loss_ha", "as": "national_loss_ha"}],
      "groupby": ["year"]
    },
    {"calculate": "datum.national_loss_ha / 1000", "as": "loss_kha"}
  ],
  "layer": [
    {
      "mark": {"type": "area", "color": "#c25e1e", "opacity": 0.25, "interpolate": "monotone"},
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {"labelAngle": 0, "labelOverlap": "greedy"}
        },
        "y": {"field": "loss_kha", "type": "quantitative", "title": "Loss (000 ha)"}
      }
    },
    {
      "mark": {"type": "line", "color": "#c25e1e", "strokeWidth": 2.5, "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "loss_kha", "type": "quantitative"},
        "tooltip": [
          {"field": "year", "type": "ordinal"},
          {"field": "loss_kha", "type": "quantitative", "format": ",.0f", "title": "Loss (000 ha)"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.year == 2012 || datum.year == 2014"}],
      "mark": {"type": "point", "size": 120, "color": "#1f2421", "filled": true},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "loss_kha", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.year == 2012 || datum.year == 2014"}],
      "mark": {"type": "text", "dy": -16, "fontSize": 11, "fontWeight": "bold", "font": "Inter"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "loss_kha", "type": "quantitative"},
        "text": {"field": "year", "type": "ordinal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "domain": false, "ticks": false,
      "labelFont": "Inter", "titleFont": "Inter"
    }
  }
}
