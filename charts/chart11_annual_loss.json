{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "National forest loss peaked in 2012 and 2014",
    "subtitle": "Malaysia, annual tree cover loss (thousand hectares), 2001–2024",
    "anchor": "start"
  },
  "width": 420,
  "height": 320,
  "data": {
    "url": "data/area_vs_loss_yearly.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#c25e1e",
        "opacity": 0.18,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "values": [
              2001,
              2005,
              2010,
              2015,
              2020,
              2024
            ]
          }
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative",
          "title": "Tree cover loss (000 ha)"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#c25e1e",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "forest_loss_kha",
            "type": "quantitative",
            "format": ".1f",
            "title": "Loss (000 ha)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2012 || datum.year == 2014"
        }
      ],
      "mark": {
        "type": "point",
        "color": "#c25e1e",
        "filled": true,
        "size": 90,
        "stroke": "#fff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2012"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1f2421",
        "font": "Inter"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "value": "628 kha"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2014"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1f2421",
        "font": "Inter"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "forest_loss_kha",
          "type": "quantitative"
        },
        "text": {
          "value": "646 kha"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "grid": true,
      "gridColor": "#eeece4"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  }
}