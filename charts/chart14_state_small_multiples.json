{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Sarawak and Sabah carried most of the forest loss",
    "subtitle": "Annual tree cover loss by state, 2001–2024 (thousand hectares). All panels share the same y-axis.",
    "anchor": "start"
  },
  "data": {
    "url": "data/forest_loss_by_state_long.csv"
  },
  "transform": [
    {
      "calculate": "datum.tc_loss_ha / 1000",
      "as": "loss_kha"
    }
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "header": {
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelColor": "#1f2421",
      "title": null
    },
    "sort": {
      "op": "max",
      "field": "loss_kha",
      "order": "descending"
    }
  },
  "columns": 4,
  "spec": {
    "width": 165,
    "height": 105,
    "layer": [
      {
        "mark": {
          "type": "area",
          "color": "#c25e1e",
          "opacity": 0.45,
          "interpolate": "monotone"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal",
            "axis": {
              "labelAngle": 0,
              "labelOverlap": "greedy",
              "values": [2001, 2010, 2024],
              "labelFontSize": 9
            },
            "title": null
          },
          "y": {
            "field": "loss_kha",
            "type": "quantitative",
            "title": null,
            "axis": {
              "labelFontSize": 9,
              "tickCount": 3
            }
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#c25e1e",
          "strokeWidth": 2.2,
          "interpolate": "monotone"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "field": "loss_kha",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "state",
              "type": "nominal"
            },
            {
              "field": "year",
              "type": "ordinal"
            },
            {
              "field": "loss_kha",
              "type": "quantitative",
              "format": ",.1f",
              "title": "Loss (000 ha)"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "mean",
                "field": "loss_kha",
                "as": "mean_loss"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#4b5563",
          "strokeDash": [3, 3]
        },
        "encoding": {
          "y": {
            "field": "mean_loss",
            "type": "quantitative"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.state == 'Sarawak' && datum.year == 2012"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 10,
          "font": "Inter",
          "dy": -8,
          "dx": 4,
          "color": "#1f2421"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "field": "loss_kha",
            "type": "quantitative"
          },
          "text": {
            "value": "Peak: 2012 ▲"
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#6b7570",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "grid": false
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "titleFont": "Inter",
      "titleFontSize": 12
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#1f2421",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b7570",
      "anchor": "start"
    }
  }
}
